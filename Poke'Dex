import React from 'react';

export default function PokemonCardTracker() {
  const STORAGE_KEY = 'pokemon-card-tracker';

  const [cards, setCards] = React.useState(() => {
    const saved = localStorage.getItem(STORAGE_KEY);
    return saved ? JSON.parse(saved) : [];
  });

  const [form, setForm] = React.useState({
    number: '',
    name: '',
    set: '',
    owned: true,
    image: '',
  });

  const [search, setSearch] = React.useState('');

  React.useEffect(() => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cards));
  }, [cards]);

  const handleImageUpload = (event) => {
    const file = event.target.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onloadend = () => {
      setForm({
        ...form,
        image: reader.result,
      });
    };

    reader.readAsDataURL(file);
  };

  const addCard = () => {
    if (!form.number || !form.name) return;

    const exists = cards.find((c) => c.number === form.number);

    if (exists) {
      alert('A card with that number already exists.');
      return;
    }

    const updated = [
      ...cards,
      {
        id: crypto.randomUUID(),
        ...form,
      },
    ].sort((a, b) => Number(a.number) - Number(b.number));

    setCards(updated);

    setForm({
      number: '',
      name: '',
      set: '',
      owned: true,
      image: '',
    });
  };

  const deleteCard = (id) => {
    setCards(cards.filter((card) => card.id !== id));
  };

  const toggleOwned = (id) => {
    setCards(
      cards.map((card) =>
        card.id === id ? { ...card, owned: !card.owned } : card
      )
    );
  };

  const filteredCards = cards.filter((card) => {
    const text = `${card.number} ${card.name} ${card.set}`.toLowerCase();
    return text.includes(search.toLowerCase());
  });

  return (
    <div className="min-h-screen bg-slate-100 p-6">
      <div className="max-w-6xl mx-auto space-y-6">
        <div className="bg-white rounded-3xl shadow-lg p-6">
          <h1 className="text-4xl font-bold mb-2">Pokémon Card Tracker</h1>
          <p className="text-slate-600">
            Track your Pokémon cards by number with photo support.
          </p>
        </div>

        <div className="grid lg:grid-cols-2 gap-6">
          <div className="bg-white rounded-3xl shadow-lg p-6 space-y-4">
            <h2 className="text-2xl font-semibold">Add Card</h2>

            <div>
              <label className="block text-sm font-medium mb-1">
                Card Number
              </label>
              <input
                type="number"
                value={form.number}
                onChange={(e) =>
                  setForm({ ...form, number: e.target.value })
                }
                className="w-full border rounded-2xl p-3"
                placeholder="25"
              />
            </div>

            <div>
              <label className="block text-sm font-medium mb-1">
                Pokémon Name
              </label>
              <input
                type="text"
                value={form.name}
                onChange={(e) =>
                  setForm({ ...form, name: e.target.value })
                }
                className="w-full border rounded-2xl p-3"
                placeholder="Pikachu"
              />
            </div>

            <div>
              <label className="block text-sm font-medium mb-1">
                Card Set
              </label>
              <input
                type="text"
                value={form.set}
                onChange={(e) =>
                  setForm({ ...form, set: e.target.value })
                }
                className="w-full border rounded-2xl p-3"
                placeholder="Base Set"
              />
            </div>

            <div>
              <label className="block text-sm font-medium mb-2">
                Upload Card Photo
              </label>

              <input
                type="file"
                accept="image/*"
                onChange={handleImageUpload}
                className="w-full border rounded-2xl p-3 bg-white"
              />
            </div>

            {form.image && (
              <div className="border rounded-2xl p-3">
                <img
                  src={form.image}
                  alt="Preview"
                  className="w-full h-64 object-cover rounded-2xl"
                />
              </div>
            )}

            <div className="flex items-center gap-2">
              <input
                type="checkbox"
                checked={form.owned}
                onChange={(e) =>
                  setForm({ ...form, owned: e.target.checked })
                }
              />
              <span>Owned</span>
            </div>

            <button
              onClick={addCard}
              className="w-full bg-red-500 hover:bg-red-600 text-white font-semibold rounded-2xl p-3 transition"
            >
              Add Card
            </button>
          </div>

          <div className="bg-white rounded-3xl shadow-lg p-6 space-y-4">
            <div className="flex items-center justify-between gap-4 flex-wrap">
              <h2 className="text-2xl font-semibold">Collection</h2>
              <div className="text-sm text-slate-600">
                Total Cards: {cards.length}
              </div>
            </div>

            <input
              type="text"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search by number, name, or set"
              className="w-full border rounded-2xl p-3"
            />

            <div className="space-y-4 max-h-[700px] overflow-auto pr-1">
              {filteredCards.length === 0 ? (
                <div className="text-center text-slate-500 py-12 border rounded-2xl">
                  No cards found.
                </div>
              ) : (
                filteredCards.map((card) => (
                  <div
                    key={card.id}
                    className="border rounded-3xl overflow-hidden bg-slate-50"
                  >
                    {card.image ? (
                      <img
                        src={card.image}
                        alt={card.name}
                        className="w-full h-64 object-cover"
                      />
                    ) : (
                      <div className="h-64 flex items-center justify-center bg-slate-200 text-slate-500">
                        No Photo
                      </div>
                    )}

                    <div className="p-4 flex items-start justify-between gap-4">
                      <div>
                        <div className="text-xl font-bold">
                          #{card.number} — {card.name}
                        </div>

                        <div className="text-sm text-slate-600 mt-1">
                          {card.set || 'Unknown Set'}
                        </div>

                        <div
                          className={`text-sm mt-2 font-medium ${
                            card.owned
                              ? 'text-green-600'
                              : 'text-orange-500'
                          }`}
                        >
                          {card.owned ? 'Owned' : 'Missing'}
                        </div>
                      </div>

                      <div className="flex flex-col gap-2">
                        <button
                          onClick={() => toggleOwned(card.id)}
                          className="px-4 py-2 rounded-xl bg-blue-500 text-white hover:bg-blue-600"
                        >
                          Toggle
                        </button>

                        <button
                          onClick={() => deleteCard(card.id)}
                          className="px-4 py-2 rounded-xl bg-slate-200 hover:bg-slate-300"
                        >
                          Delete
                        </button>
                      </div>
                    </div>
                  </div>
                ))
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
